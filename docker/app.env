# -------------------------------------------------
# shared
# -------------------------------------------------

API_USERNAME=agrisat-demo
API_PASSWORD=agrisat-demo

# -------------------------------------------------
# agrisat-agent
# -------------------------------------------------

API_HOST=http://agrisat-api:8000/api

AGENT_WEB=True
AGENT_DSN=sqlite+aiosqlite:////data/sessions.db

GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_API_KEY=API-KEY-HERE

OLLAMA_ENABLE=True
OLLAMA_MODEL=gemma4:12b
OLLAMA_API_BASE=http://localhost:8001

OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://mlflow.ritsu.net/v1/traces
OTEL_EXPORTER_OTLP_TRACES_HEADERS=x-mlflow-experiment-id=3

# -------------------------------------------------
# agrisat-api
# -------------------------------------------------

DSN=/data/data.db

# -------------------------------------------------
# agrisat-web
# -------------------------------------------------

VITE_AGENT_HOST=http://agrisat-agent:8080
VITE_API_HOST=http://agrisat-api:8000/api
VITE_API_USERNAME=agrisat-demo
VITE_API_PASSWORD=agrisat-demo
VITE_AI_ENABLED=false
# the api credentials above must match the shared version above!
